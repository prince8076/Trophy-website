# Copy to .env and fill in. Never commit a real .env.
# DATABASE_URL=sqlite:///./shreeji.db
# ADMIN_KEY=change-this-to-a-long-random-string
# FRONTEND_ORIGINS=http://localhost:5173,https://your-domain.com
# DOCS_ENABLED=true  # set to false in production
# RATE_LIMIT_GENERAL=120  # requests/min/IP
# RATE_LIMIT_WRITE=10     # POSTs/min/IP (spam control)
# RATE_LIMIT_ADMIN=10     # admin attempts/min/IP (brute-force control)
