# Copy to .env (which is gitignored — never commit a real .env).
# Local dev: backend on :8000
VITE_API_URL=http://localhost:8000
# Production: replace with your deployed API URL, e.g.
# VITE_API_URL=https://shreeji-api.onrender.com
# Important: Vite inlines this at BUILD time. Changing it means
# rebuilding and redeploying the frontend — restarting the
# backend alone does not change the frontend's API URL.
# If VITE_API_URL is not set, the site falls back to its
# hardcoded sample catalogue and mock feedback.
